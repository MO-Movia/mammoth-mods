{
  "name": "@modusoperandi/mammoth",
  "version": "1.13.0",
  "description": "Convert Word documents from docx to simple HTML",
  "keywords": [
    "docx",
    "html",
    "office",
    "word"
  ],
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./lib/*": "./lib/*.js",
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MO-Movia/mammoth-mods.git"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.8.15",
    "base64-js": "^1.5.1",
    "dingbat-to-unicode": "^1.0.1",
    "jszip": "^3.7.1",
    "lop": "^0.4.2",
    "underscore": "^1.13.8"
  },
  "devDependencies": {
    "@types/node": "^20.2.5",
    "eslint": "^8.57.1",
    "hamjest": "^4.0.1",
    "mocha": "^12.0.3",
    "typescript": "^5.0.4",
    "xmlbuilder": "^10.0.0"
  },
  "browser": {
    "./lib/unzip.js": "./browser/unzip.js",
    "./lib/docx/files.js": "./browser/docx/files.js"
  },
  "scripts": {
    "lint": "eslint lib browser test",
    "pretest": "eslint lib test",
    "test": "mocha 'test/**/*.tests.js'",
    "test:coverage": "npm test",
    "ci:build": "rm -rf dist && mkdir -p dist && cp -r lib browser package.json LICENSE README.md dist/",
    "check-typescript": "tsc --noEmit lib/index.d.ts"
  },
  "license": "BSD-2-Clause",
  "engines": {
    "node": ">=14.0.0"
  },
  "volta": {
    "node": "26.8.2"
  }
}
